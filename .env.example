DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Only these internal test accounts may restart a completed assessment by
# registering again with the same email and phone number. Separate emails with commas.
TEST_RETAKE_EMAILS=luxmoreai@gmail.com

# Production multi-language code execution. Point this to your private,
# network-isolated Judge0 CE/API deployment (for example https://judge.example.com).
# When set, the coding-round picker lists every language returned by Judge0.
JUDGE0_API_URL=
JUDGE0_AUTH_TOKEN=

# Alternative: managed Judge0 through RapidAPI (no VPS required). Subscribe to
# Judge0 CE or Judge0 Extra CE, then add these only in Vercel's environment
# variables. Never put the key in frontend code or commit it to Git.
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

# Neon PostgreSQL values (copy them from the Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=replace-me
PGHOST=your-neon-host.neon.tech
PGPORT=5432
